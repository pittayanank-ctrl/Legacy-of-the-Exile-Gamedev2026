metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_3c76j"]
script = ExtResource("11_xmwul")
speaker_name = "Edric Vale"
dialogue_text = "I am ready, Father. Tell me where we strike."
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_f1dvb"]
script = ExtResource("11_xmwul")
speaker_name = "Aldric Vale"
dialogue_text = "You must understand... they are the knights who robbed us of everything."
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_r1rum"]
script = ExtResource("11_xmwul")
speaker_name = "Edric Vale"
dialogue_text = "I remember, Father. And this time... I will make them pay."
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_25u0f"]
script = ExtResource("11_xmwul")
speaker_name = "Aldric Vale"
dialogue_text = "Then go to the castle. They are still there."
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_fk72f"]
script = ExtResource("11_xmwul")
speaker_name = "Edric Vale"
dialogue_text = "I will return victorious, Father. That, I promise you."
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_xrlua"]
script = ExtResource("11_xmwul")
speaker_name = "Aldric Vale"
dialogue_text = "Watch yourself, my son... Do not allow vengeance to consume you and bring your downfall."
