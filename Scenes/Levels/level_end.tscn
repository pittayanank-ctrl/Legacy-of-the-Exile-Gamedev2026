[sub_resource type="Resource" id="Resource_n5jy4"]
script = ExtResource("12_culcw")
speaker_name = "King Alaric III"
dialogue_text = "ในที่สุด... เราก็ได้พบกันอีกครั้ง"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_ewk7j"]
script = ExtResource("12_culcw")
speaker_name = "Aldric Vale"
dialogue_text = "ข้าไม่คิดว่าจะมีวันที่ได้เห็นท่านกลับมายืนอยู่ที่นี่อีก"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_j36te"]
script = ExtResource("11_7e27o")
left_portrait = ExtResource("14_ewk7j")
right_portrait = ExtResource("15_jwlcv")
dialogue_lines = Array[ExtResource("12_culcw")]([SubResource("Resource_n5jy4"), SubResource("Resource_ewk7j")])
metadata/_custom_type_script = "uid://dgimd832oimtc"

[sub_resource type="Resource" id="Resource_oef4l"]
script = ExtResource("12_culcw")
speaker_name = "Edric Vale"
dialogue_text = "พ่อ... ท่านสองคนรู้จักกันมาก่อนงั้นหรือ?"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_lryru"]
script = ExtResource("12_culcw")
speaker_name = "Aldric Vale"
dialogue_text = "ใช่... พระองค์คือคนที่ข้าเคยสาบานว่าจะปกป้อง แต่ทุกอย่างกลับพังทลายลงเพราะกลุ่มอัศวินที่กระหายอำนาจ"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_jwlcv"]
script = ExtResource("11_7e27o")
left_portrait = ExtResource("13_uoe4u")
right_portrait = ExtResource("14_fpfjg")
dialogue_lines = Array[ExtResource("12_culcw")]([SubResource("Resource_oef4l"), SubResource("Resource_lryru")])
metadata/_custom_type_script = "uid://dgimd832oimtc"

[sub_resource type="Resource" id="Resource_11rhl"]
script = ExtResource("12_culcw")
speaker_name = "King Alaric III"
dialogue_text = "ข้าสูญเสียทั้งอาณาจักร... และคิดว่าเจ้าคงตายไปแล้ว"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_ekvg5"]
script = ExtResource("12_culcw")
speaker_name = "Aldric Vale"
dialogue_text = "ข้าหนีมาเพื่อปกป้องลูกของข้า และเก็บความจริงทั้งหมดไว้กับตัวเอง"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_w7vtg"]
script = ExtResource("11_7e27o")
left_portrait = ExtResource("14_ewk7j")
right_portrait = ExtResource("15_jwlcv")
dialogue_lines = Array[ExtResource("12_culcw")]([SubResource("Resource_11rhl"), SubResource("Resource_ekvg5")])
metadata/_custom_type_script = "uid://dgimd832oimtc"

[sub_resource type="Resource" id="Resource_i2uy6"]
script = ExtResource("12_culcw")
speaker_name = "Edric Vale"
dialogue_text = "ตลอดเวลาที่ผ่านมา... ข้าคิดว่าข้าต้องแก้แค้นให้พ่อ"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_7e27o"]
script = ExtResource("12_culcw")
speaker_name = "Aldric Vale"
dialogue_text = "และตอนนี้เจ้าก็ได้ทำมันแล้ว"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_culcw"]
script = ExtResource("12_culcw")
speaker_name = "Edric Vale"
dialogue_text = "แต่ข้าเพิ่งรู้ว่า... การแก้แค้นไม่ได้ทำให้สิ่งที่เสียไปกลับคืนมา"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

