[sub_resource type="Resource" id="Resource_iy56i"]
script = ExtResource("10_v3kri")
speaker_name = "Elena"
dialogue_text = "เจ้าคือคนที่ Aldric ส่งมาสินะ?"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_ovfk7"]
script = ExtResource("10_v3kri")
speaker_name = "Edric Vale"
dialogue_text = "ใช่ครับ พ่อบอกว่าท่านสามารถฝึกผมได้"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_eqgor"]
script = ExtResource("10_v3kri")
speaker_name = "Elena"
dialogue_text = "ข้ารู้เรื่องของพ่อเจ้า...และรู้ด้วยว่าเหตุใดเจ้าถึงมาที่นี่"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_b6y0q"]
script = ExtResource("10_v3kri")
speaker_name = "Edric Vale"
dialogue_text = "ผมต้องการแข็งแกร่งขึ้น เพื่อจัดการกับพวกอัศวินที่หักหลังพ่อ"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_dx24p"]
script = ExtResource("10_v3kri")
speaker_name = "Elena"
dialogue_text = "ความแค้นเพียงอย่างเดียวไม่ทำให้เจ้าชนะหรอก มันมีแต่จะทำให้เจ้าประมาท"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_bpk8j"]
script = ExtResource("10_v3kri")
speaker_name = "Edric Vale"
dialogue_text = "แล้วผมต้องทำอย่างไร?"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_grac3"]
script = ExtResource("10_v3kri")
speaker_name = "Elena"
dialogue_text = "เรียนรู้ที่จะควบคุมดาบ ป้องกันการโจมตี และรู้ว่าเมื่อใดควรสู้...เมื่อใดควรถอย"
speaker_side = 1
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

[sub_resource type="Resource" id="Resource_gnyrb"]
script = ExtResource("10_v3kri")
speaker_name = "Edric Vale"
dialogue_text = "ถ้าอย่างนั้น...ได้โปรดฝึกผมด้วยครับ"
metadata/_custom_type_script = "uid://cdhi2dfrqh1wr"

