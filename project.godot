AudioManager="*res://Scenes/Managers/audio_manager.tscn"
CombatManager="*uid://caldwsgu7ncc"
DialogueManager="*uid://b1ghiiiykbf0"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="2D-Platformer-Starter"

[editor_plugins]

enabled=PackedStringArray()

